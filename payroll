def calculate_gross_pay(employee):
    return employee.hours_worked * employee.hourly_rate


def calculate_tax(gross_pay):
    return gross_pay * 0.10


def calculate_net_pay(gross_pay, tax):
    return gross_pay - tax


def display_payroll(employee):
    gross_pay = calculate_gross_pay(employee)
    tax = calculate_tax(gross_pay)
    net_pay = calculate_net_pay(gross_pay, tax)

    print("\n========== PAYROLL ==========")
    print(f"Employee ID: {employee.employee_id}")
    print(f"Employee Name: {employee.name}")
    print(f"Hours Worked: {employee.hours_worked:.2f}")
    print(f"Hourly Rate: ${employee.hourly_rate:.2f}")
    print(f"Gross Pay: ${gross_pay:.2f}")
    print(f"Tax (10%): ${tax:.2f}")
    print(f"Net Pay: ${net_pay:.2f}")
    print("=============================")